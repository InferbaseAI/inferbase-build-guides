# --- Required ---------------------------------------------------------------
# An Inferbase API key for THIS app (create one at https://inferbase.ai/api-keys).
# Give it a daily spend cap: a public chat box is an open endpoint that spends your money.
INFERBASE_API_KEY=
# The OpenAI-compatible base URL. Change it only for a self-hosted or staging Inferbase.
INFERBASE_BASE_URL=https://api.inferbase.ai/v1

# --- Knowledge ----------------------------------------------------------------
# Where `npm run index` reads your docs: an llms-full.txt (llmstxt.org) where each page
# starts with a "## Title" line followed by "Source: <url>". Inferbase's own docs by default.
DOCS_SOURCE_URL=https://inferbase.ai/llms-full.txt
# Only pages whose Source URL starts with one of these are indexed; comma-separated (empty =
# every page). Inferbase's default takes the docs, the comparisons and the solutions build
# guides, not the blog.
DOCS_SOURCE_PREFIX=https://inferbase.ai/docs,https://inferbase.ai/compare,https://inferbase.ai/solutions

# --- Answers -----------------------------------------------------------------
# "auto" lets your routing policy pick the model per request. Name a model to pin one.
CHAT_MODEL=auto
# Thinking: none (default) answers directly. A reasoning model otherwise spends MAX_ANSWER_TOKENS
# thinking first and can end with no answer. low / medium / high turn it on.
REASONING_EFFORT=none
# Longest answer, in tokens. Short answers keep a public bot cheap and readable.
MAX_ANSWER_TOKENS=700
# Shown in the header and the system prompt: "Inferbase Copilot".
PRODUCT_NAME=Inferbase
ASSISTANT_NAME=Copilot
# Where your published comparisons with other products live; a question about a product with no
# comparison in the index is pointed here. Empty to only say there is none.
COMPARISONS_URL=https://inferbase.ai/compare

# --- Abuse controls (public deployments) ---------------------------------------
# Cloudflare Turnstile. When the secret is set, every chat message and handoff needs a fresh token
# or the signed one-hour session the first passed check returns (keyed from this secret). The site
# key's widget must list this app's hostname (and localhost for development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Per IP address: messages per minute and per day.
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
# Longest message a visitor may send, in characters, and the longest conversation, in turns.
MAX_MESSAGE_CHARS=2000
MAX_TURNS=20

# --- Handoff to a person -------------------------------------------------------------
# "Contact support" sends the conversation by email through Resend. Unset = the form is hidden.
RESEND_API_KEY=
HANDOFF_TO=
HANDOFF_FROM=

# --- Embedding ------------------------------------------------------------------
# Origins allowed to frame this app (space separated), e.g. https://your-site.com
# Read at BUILD time (Next.js computes response headers when it builds): set it before `next build`.
FRAME_ANCESTORS=

# --- Account mode (signed in, inside your portal) ----------------------------------
# Opened as /?embed=1&account=1 by your portal, which hands the frame the person's read-only token.
# Origins allowed to send that token (comma separated), e.g. https://inferbase.ai. Empty = off.
ACCOUNT_PARENT_ORIGINS=
# Optional: a separate key (with its own daily cap) that pays for account-mode answers.
INFERBASE_ACCOUNT_API_KEY=
# Optional: where the account tools read from, when not the INFERBASE_BASE_URL host.
INFERBASE_ACCOUNT_API_URL=
# Model calls one account answer may make: each tool round is one, plus the answer.
MAX_TOOL_ROUNDS=3
